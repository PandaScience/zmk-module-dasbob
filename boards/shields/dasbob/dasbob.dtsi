#include <dt-bindings/zmk/matrix_transform.h>
#include "dasbob-layouts.dtsi"

// https://zmk.dev/docs/development/hardware-integration/physical-layouts
// put this block where the matrix transform is defined
&physical_layout0 {
	transform = <&default_transform>;
};

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,physical-layout = &physical_layout0;
	};

	// https://zmk.dev/docs/development/hardware-integration/new-shield?keyboard-type=split#matrix-transform
	// use single row of 36 columns for compatibility with direct GPIO kscan driver in combination with
	// col-offset = <18> for the right split's overlay
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <36>;
		rows = <1>;
		// |  SW1   |  SW2   |  SW3   |  SW4   |  SW5   | |  SW19  |  SW20  |  SW21  |  SW22  |  SW23  |
		// |  SW6   |  SW7   |  SW8   |  SW9   |  SW10  | |  SW24  |  SW25  |  SW26  |  SW27  |  SW28  |
		// |  SW11  |  SW12  |  SW13  |  SW14  |  SW15  | |  SW29  |  SW30  |  SW31  |  SW32  |  SW33  |
		//                   |  SW16  |  SW17  |  SW18  | |  SW34  |  SW35  |  SW36  |
		map = <
			RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)    RC(0,22) RC(0,21) RC(0,20) RC(0,19) RC(0,18)
			RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)    RC(0,27) RC(0,26) RC(0,25) RC(0,24) RC(0,23)
			RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)   RC(0,32) RC(0,31) RC(0,30) RC(0,29) RC(0,28)
			                  RC(0,15) RC(0,16) RC(0,17)   RC(0,35) RC(0,34) RC(0,33)
		>;
	};

	// https://zmk.dev/docs/config/kscan#direct-gpio-driver
	// cmp. https://github.com/zmkfirmware/zmk/blob/main/app/boards/shields/a_dux/a_dux.dtsi
	// diodeless design of dasbob allows for direct kscan driver since each key has a dedicated GPIO.
	kscan0: kscan {
		compatible = "zmk,kscan-gpio-direct";
		wakeup-source;

		// https://zmk.dev/docs/config/kscan#devicetree-2
		// https://nicekeyboards.com/docs/nice-nano/pinout-schematic/
		// This list maps the pins of the MCU to the connected switches as routed on the PCB shield:
		//   > A direct pin defined in the input-gpios property is considered a column when used in
		//   > a matrix transform; e.g. the 5th pin on the list can be referred to using RC(0,4).
		// Check shield wiring in kicad against the MCU pinout schematic (watch orientation!) for correct mappings.
		//
		// NOTE: in addition to the pro micro compatible pins (e.g. &gpio029 = &pro_micro 20), the
		// dasbob further needs the additional 3 middle pins of the nice nano to cover all switches.
		input-gpios =
			<&gpio1  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio1  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio0  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,

			<&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,

			<&gpio0  9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio1  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,

			<&gpio1  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio1  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			<&gpio1  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		;
	};
};
